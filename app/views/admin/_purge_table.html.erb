<table class="table table-striped">
    <tr>
        <th class="col-xs-4">
            Title
        </th>
        <th class="col-xs-2">
            Total Copies
        </th>
        <th class="col-xs-2">
            Last Copy Added On
        </th>
        <th class="col-xs-2">
            C/O Last Four Shows
        </th>
        <th class="col-xs-2">
            C/O Last Five Shows
        </th>
    </tr>
    <% recommendations.each_with_index do |p_row, index| %>
        <tr data-event-id="<%= index %>">
            <td class="col-xs-4">
                <%= p_row['title'] %>
            </td>
            <td class="col-xs-2">
                <%= p_row['copies'] %>
            </td>
            <td class="col-xs-2">
                <%= p_row['latest_created_at'] %>
            </td>
            <td class="col-xs-2">
                <%= p_row['checkouts_from_four'] %>
            </td>
            <td class="col-xs-2">
                <%= p_row['checkouts_from_five'] %>
            </td>
        </tr>
    <% end %>
</table>