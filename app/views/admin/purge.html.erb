<% content_for :title, 'Games to Purge' %>

<%= render 'admin/breadcrumb', page: 'Games to Purge' %>

<div class="row"><br /></div>

<% if Event.four_events_ago %>
    <div class="row">
        <div class="col-md-2"></div>
        <div class="col-md-8">
            <p>Titles listed here had at least 50% of their copies added to the library prior to <%= Event.two_events_ago.formatted_name %> and have <em>0 checkouts across the last three events (<%= Event.last_three_event_names %>)</em>.</p>
        </div>
        <div class="col-md-2"></div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="btn-group-toggle search-btn" data-toggle="buttons">
                <label class="btn btn-default <%= @setup_scanned_only ? 'active' : '' %>">
                    <input type="checkbox" id="purge-setup-scanned" <%= @setup_scanned_only ? 'checked' : '' %>> Hide games not setup scanned
                </label>
            </div>
        </div>
    </div>

    <div class="row">
        <br />
    </div>

    <div class="row">
        <div id="purge-table">
            <%= render 'purge_table', recommendations: @purge_recommendations %>
        </div>
    </div>
<% else %>
    <div class="row">
        <div class="col-md-2"></div>
        <div class="col-md-8">
            <p class="alert alert-warning" style="text-align: center;">
                Data from four events or more is required in order to give purge recommendations.
            </p>
        </div>
        <div class="col-md-2"></div>
    </div>
<% end %>
