<% content_for :title, 'Return' %>

<div class="row" id="return-page" data-checkout-mode="return">
    <div class="col-xs-hidden col-sm-2"></div>
    <div class="col-xs-10 col-sm-7 glyphicon-custom-left">
        <input type="text" id="g-barcode" class="form-control" placeholder="Scan GAME's barcode to return." autofocus autocomplete="off"/>
        <span class="glyphicon glyphicon-tower form-control-feedback"></span>
        <h3 id="g-name"></h3>
    </div>
    <div class="col-xs-2 col-sm-1">
        <input id="checkouts-x-btn" type="button" class="btn btn-default" style="display:none;" value="X" />
    </div>
    <div class="col-xs-hidden col-sm-2"></div>
</div>